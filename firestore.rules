rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛡️ ADMIN HELPERS
    // ==========================================
    
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email in ['akhilsharma.ptk22@gmail.com', 'sharmakhil1704@gmail.com']
      );
    }

    // ==========================================
    // 👤 USER PROFILES & USERNAMES
    // ==========================================
    
    match /users/{userId} {
      allow read: if request.auth != null;
      
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendingIncomingRequests', 
          'pendingOutgoingRequests', 
          'friends', 
          'blockedUsers', 
          'friendsSince'
        ])
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // ✅ UPDATED: Allow users to delete their own profile
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null; 
      }
    }

    match /usernames/{username} {
      allow read: if true;
      // ✅ UPDATED: Allow deletion if the user owns the reservation
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 🤝 FRIEND REQUESTS
    // ==========================================
    
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
      // ✅ UPDATED: Explicit delete permission for requests involving the user
      allow delete: if request.auth != null && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 🍾 DRINK LOGS & REVIEWS
    // ==========================================
    
    match /drink_logs/{logId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || request.resource.data.creatorId == request.auth.uid);
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid ||
        isAdmin() ||
        // Allow participants to accept/remove themselves from the shared log
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedParticipantIds', 'participantCount']) &&
          request.resource.data.userId == resource.data.userId &&
          (request.auth.uid in request.resource.data.acceptedParticipantIds || request.auth.uid in resource.data.acceptedParticipantIds)
        )
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 🏷️ DRINK LOG PARTICIPANTS (TAGGING)
    // ==========================================
    
    match /drink_log_participants/{participantId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        // If inviting someone, allow if the current user is the creator of the corresponding drink log
        get(/databases/$(database)/documents/drink_logs/$(request.resource.data.logId)).data.creatorId == request.auth.uid ||
        get(/databases/$(database)/documents/drink_logs/$(request.resource.data.logId)).data.userId == request.auth.uid
      );
      allow update: if request.auth != null && (
        // A participant can update their own status (e.g. accept or decline)
        (resource.data.userId == request.auth.uid && request.resource.data.role == resource.data.role && request.resource.data.logId == resource.data.logId) ||
        // The creator of the log can update any participant's status or role
        get(/databases/$(database)/documents/drink_logs/$(resource.data.logId)).data.creatorId == request.auth.uid ||
        get(/databases/$(database)/documents/drink_logs/$(resource.data.logId)).data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/drink_logs/$(resource.data.logId)).data.creatorId == request.auth.uid ||
        get(/databases/$(database)/documents/drink_logs/$(resource.data.logId)).data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ==========================================
    // 🌟 WISHLISTS
    // ==========================================
    
    match /wishlists/{wishId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // 🏷️ ALCOHOL CATALOG & SESSIONS
    // ==========================================
    
    match /alcohols/{alcoholId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activity_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // ==========================================
    // 📝 BETA FEEDBACK
    // ==========================================
    
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      // ✅ UPDATED: Allow users to delete their own feedback during account wipe
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
  }
}
